/* Port: hold-time accounting is a diagnostic and used to run on every
 * kernel call (two QPC reads plus a table scan). Default off. */
static int gcpu_stats_on(void)
{
    static int on = -1;
    if (on < 0) { const char *e = getenv("OOGIE_GCPU_STATS"); on = e && *e == '1'; }
    return on;
}
static void gcpu_leave(void)
{
    LARGE_INTEGER now;
    AcquireSRWLockExclusive(&g_gcpu_m);
    if (gcpu_stats_on()) {
        QueryPerformanceCounter(&now);
        /* time held, by host thread (a small open-addressed table) */
        DWORD id = GetCurrentThreadId();
        int k = (int)(id % GCPU_HOLD_N), n;
        if (!g_gcpu_qpf.QuadPart) QueryPerformanceFrequency(&g_gcpu_qpf);
        for (n = 0; n < GCPU_HOLD_N; n++, k = (k + 1) % GCPU_HOLD_N)
            if (g_gcpu_hold_id[k] == id || !g_gcpu_hold_id[k]) {
                g_gcpu_hold_id[k] = id;
                g_gcpu_hold_p[k] = g_gcpu_holder_p;
                g_gcpu_hold_ms[k] += (double)(now.QuadPart - g_gcpu_held_at.QuadPart) * 1000.0
                                     / (double)g_gcpu_qpf.QuadPart;
                break;
            }
    }
    int wake_waiters = g_gcpu_nw > 0;
    int timed_waits = g_gcpu_starve_ms > 0;
    g_gcpu_busy = 0;
    ReleaseSRWLockExclusive(&g_gcpu_m);
    if (wake_waiters) {
        /* The condition variable can wake a waiter other than the next ticket.
         * With indefinite waits, broadcast so that ticket can take the CPU. */
        if (timed_waits)
            WakeConditionVariable(&g_gcpu_cv);
        else
            WakeAllConditionVariable(&g_gcpu_cv);
    }
}