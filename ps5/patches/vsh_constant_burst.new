int oogie_vsh_constant_burst(const uint32_t *words, uint32_t count)
{
    if (vsh_dump_enabled())
        return 0;
    uint32_t index = s_const_load, component = s_const_word;
    for (uint32_t i = 0; i < count; ++i) {
        if (index < NV2A_VSH_CONSTANTS)
            store_constant_word(index, component, words[i]);
        if (++component == 4) {
            component = 0;
            ++index;
        }
    }
    s_const_load = index;
    s_const_word = component;
    return 1;
}

