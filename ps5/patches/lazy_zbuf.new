static struct { uint32_t offset; float *z; int pending; float pending_v; } s_zbufs[4];
static int s_ftrace;            /* frame trace: 0 idle, 2 tracing, 3 done */
static int s_zbuf_next;

static float zclear_value(void)
{
    /* Zeta format in SURFACE_FORMAT bits 4-7: 1 is Z16, 2 is Z24S8. */
    uint32_t zf = (s_gpu.format >> 4) & 0xF;
    return zf == 1 ? (float)(s_gpu.zstencil_clear & 0xFFFF)
                   : (float)(s_gpu.zstencil_clear >> 8);
}

/* The zeta surface s depth buffer, created on demand. */
static int zbuf_slot(int create)
{
    int i;

    for (i = 0; i < 4; i++)
        if (s_zbufs[i].z && s_zbufs[i].offset == s_gpu.zeta_offset)
            return i;
    if (!create)
        return -1;
    i = s_zbuf_next++ & 3;
    if (!s_zbufs[i].z)
        s_zbufs[i].z = (float *)malloc(sizeof(float) * NV_ZBUF_W * NV_ZBUF_H);
    if (!s_zbufs[i].z)
        return -1;
    s_zbufs[i].offset = s_gpu.zeta_offset;
    s_zbufs[i].pending = 1;
    s_zbufs[i].pending_v = 3.4e38f;
    return i;
}

static void zbuf_fill(int i)
{
    float *z = s_zbufs[i].z, v = s_zbufs[i].pending_v;
    size_t k, n = (size_t)NV_ZBUF_W * NV_ZBUF_H;

    s_zbufs[i].pending = 0;
    if (!z)
        return;
    for (k = 0; k < n; k++)
        z[k] = v;
}

static float *zbuf_current(int create)
{
    int i = zbuf_slot(create);

    if (i < 0)
        return NULL;
    if (s_zbufs[i].pending)     /* only paid for when a triangle needs it */
        zbuf_fill(i);
    return s_zbufs[i].z;
}

/* Defer the fill: the Vulkan back end draws the scene, so a frame that clears
 * the depth buffer and rasterises nothing on the CPU never touches 5 MB. */
static void zbuf_clear(void)
{
    int i = zbuf_slot(1);

    if (i < 0)
        return;
    s_zbufs[i].pending = 1;
    s_zbufs[i].pending_v = zclear_value();
}
