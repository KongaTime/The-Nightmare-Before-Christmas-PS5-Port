    if (!found && !g_cs_table_full) {
        g_cs_table_full = 1;
        xbox_log(XBOX_LOG_ERROR, XBOX_LOG_RTL,
                 "critical-section table full at %d entries; further locks "
                 "are unprotected", XBOX_CS_TABLE_SIZE);
    }
    if (found && g_cs_cache_on) {
        size_t index = (size_t)((key >> 4) & (XBOX_CS_CACHE - 1));
        __atomic_store_n(&g_cs_cache[index], xbox_cs_slot_of(found), __ATOMIC_RELEASE);
    }
    return found;
}
