typedef struct {
    int guest_thread;            /* this host thread runs a guest thread */
    int held;                    /* this thread holds the guest CPU */
    int dispatch_depth;
    DWORD host_tid;
} GuestCpuThreadState;

static RECOMP_TLS GuestCpuThreadState t_guest_cpu;

static int guest_cpu_enabled(void)
{
    if (g_guest_cpu_on < 0) {
        const char *e = getenv("RECOMP_GUEST_LOCK");
        InitializeCriticalSection(&g_guest_cpu);
        g_guest_cpu_on = e && *e == '1';
        if (g_guest_cpu_on)
            fprintf(stderr, "  [KERNEL] guest CPU lock on: one guest thread runs at a time\n");
    }
    return g_guest_cpu_on;
}

/* Called once on each host thread that runs a guest thread, before its first
 * guest instruction. */
void guest_cpu_join(void)
{
    GuestCpuThreadState *state = &t_guest_cpu;
    if (!state->host_tid)
        state->host_tid = GetCurrentThreadId();
    state->guest_thread = 1;
    if (guest_cpu_enabled() && !state->held) {
        EnterCriticalSection(&g_guest_cpu);
        state->held = 1;
    }
}

/* Project Oogie: does this thread hold the guest CPU (RECOMP_GUEST_LOCK)?
 * For port code that waits on its own locks or yields outside a kernel call
 * and must let the CPU go meanwhile (port/src/recomp_manual.c). */
int guest_cpu_held(void) { return t_guest_cpu.held; }

/* Project Oogie (dev cycle 4): a safepoint. The port calls this from guest
 * function calls while g_gcpu_preempt is set (a higher-priority thread
 * waits); the holder steps aside and queues again behind it. Only in the
 * thread's own guest code (not inside a kernel call's callback) and only at
 * PASSIVE level, which the caller checks. */
void guest_cpu_safepoint(void)
{
    GuestCpuThreadState *state = &t_guest_cpu;
    if (!state->held || state->dispatch_depth != 0)
        return;
    state->held = 0;
    LeaveCriticalSection(&g_guest_cpu);
    EnterCriticalSection(&g_guest_cpu);
    state->held = 1;
}

void guest_cpu_part(void)
{
    GuestCpuThreadState *state = &t_guest_cpu;
    if (state->held) {
        state->held = 0;
        LeaveCriticalSection(&g_guest_cpu);
    }
    state->guest_thread = 0;
}

/* A guest thread lets go of the guest CPU for the length of every kernel
 * call. */
static void kernel_thunk_dispatch(void)
{
    GuestCpuThreadState *state = &t_guest_cpu;
    if (state->held) {                        /* let other guest threads run meanwhile */
        state->held = 0;
        LeaveCriticalSection(&g_guest_cpu);
    }
    state->dispatch_depth++;
    kernel_thunk_dispatch_body();
    state->dispatch_depth--;
    /* Back to guest code: take the CPU again. Only at the outermost call --
     * a guest callback a bridge runs (an APC) returns into the bridge, not to
     * the thread's own code -- and only if the thread still exists as one. */
    if (state->guest_thread && state->dispatch_depth == 0 && guest_cpu_enabled()) {
        EnterCriticalSection(&g_guest_cpu);
        state->held = 1;
    }
}

