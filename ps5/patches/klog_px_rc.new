                        argb = pack_color(out);
                        {
                            /* PS5 port probe: what the combiners make of a
                             * pixel. Movie draws (a stage bound to LIN_L8,
                             * the Bink Y/U/V planes): the first 12. Every
                             * draw: one pixel in 4 million, to watch the
                             * intro's black fade quad over time. */
                            static volatile int px_logs, px_any_logs;
                            static volatile unsigned long px_seen;
                            int is_movie = (s_gpu.texs[0].valid && s_gpu.texs[0].color == 0x13)
                                        || (s_gpu.texs[1].valid && s_gpu.texs[1].color == 0x13)
                                        || (s_gpu.texs[2].valid && s_gpu.texs[2].color == 0x13);
                            unsigned long seen = __sync_fetch_and_add(&px_seen, 1);
                            if ((is_movie && px_logs < 12 && __sync_fetch_and_add(&px_logs, 1) < 12)
                                || ((seen % 4000000ul) == 0 && px_any_logs < 30
                                    && __sync_fetch_and_add(&px_any_logs, 1) < 30)) {
                                extern int sceKernelDebugOutText(int, const char *);
                                char pb[700];
                                snprintf(pb, sizeof pb,
                                    "[PX] sp=%05X ctrl=%08X fmt=%02X/%02X/%02X/%02X "
                                    "t0=%.2f,%.2f,%.2f,%.2f t1=%.2f,%.2f,%.2f,%.2f t2=%.2f,%.2f,%.2f,%.2f "
                                    "d0=%.2f,%.2f,%.2f,%.2f out=%.2f,%.2f,%.2f,%.2f argb=%08X "
                                    "icw0=%08X ocw0=%08X icw1=%08X ocw1=%08X icw2=%08X ocw2=%08X f0=%08X f1=%08X "
                                    "c0=%08X c1=%08X cmask=%08X blend=%d",
                                    s_gpu.rc.stage_program, s_gpu.rc.control,
                                    s_gpu.texs[0].valid ? s_gpu.texs[0].color : 0xFF,
                                    s_gpu.texs[1].valid ? s_gpu.texs[1].color : 0xFF,
                                    s_gpu.texs[2].valid ? s_gpu.texs[2].color : 0xFF,
                                    s_gpu.texs[3].valid ? s_gpu.texs[3].color : 0xFF,
                                    t[0][0], t[0][1], t[0][2], t[0][3],
                                    t[1][0], t[1][1], t[1][2], t[1][3],
                                    t[2][0], t[2][1], t[2][2], t[2][3],
                                    col[0], col[1], col[2], col[3],
                                    out[0], out[1], out[2], out[3], argb,
                                    s_gpu.rc.color_icw[0], s_gpu.rc.color_ocw[0],
                                    s_gpu.rc.color_icw[1], s_gpu.rc.color_ocw[1],
                                    s_gpu.rc.color_icw[2], s_gpu.rc.color_ocw[2],
                                    s_gpu.rc.final0, s_gpu.rc.final1,
                                    s_gpu.rc.factor0[0], s_gpu.rc.factor1[0],
                                    s_gpu.color_mask, (int)s_gpu.blend_enable);
                                sceKernelDebugOutText(0, pb);
                            }
                        }
