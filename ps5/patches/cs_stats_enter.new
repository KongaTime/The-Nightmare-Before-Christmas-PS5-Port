    /* An atomic read-modify-write per lock operation, on a cache line every
     * guest thread shares. It exists for the contention report, which is a
     * startup-time diagnostic, so it does not belong on the hot path. */
    if (g_cs_stats_on < 0)
        g_cs_stats_on = oogie_flag("cs_stats", 0);
    if (g_cs_stats_on)
        InterlockedIncrement(&g_cs_enters);
